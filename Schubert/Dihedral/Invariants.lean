import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.RingTheory.Ideal.Quotient.Defs
import Schubert.Dihedral.AuxiliaryCoordinates

/-! # Invariant and coinvariant definitions for the dihedral polynomial action

The invariant algebra consists of polynomials fixed by every group element. Its positive
augmentation ideal generates the ideal defining the coinvariant quotient.
-/

noncomputable section

namespace Schubert.Dihedral

/-- The subalgebra of polynomials fixed by the dihedral action. -/
def invariantSubalgebra (n : ℕ) [NeZero n] : Subalgebra ℂ CoordinatePolynomial :=
  ⨅ element : DihedralGroup n,
    AlgHom.equalizer (polynomialAction n element).toAlgHom (AlgHom.id ℂ CoordinatePolynomial)

/-- Membership in the invariant subalgebra means being fixed by every element. -/
theorem mem_invariantSubalgebra (n : ℕ) [NeZero n] (polynomial : CoordinatePolynomial) :
    polynomial ∈ invariantSubalgebra n ↔
      ∀ element : DihedralGroup n, polynomialAction n element polynomial = polynomial := by
  simp [invariantSubalgebra, Algebra.mem_iInf, AlgHom.mem_equalizer]

/-- The quadratic candidate for the basic invariant of degree two. -/
def quadraticInvariant : CoordinatePolynomial := auxiliaryU * auxiliaryV

/-- The degree-n candidate with the sign prescribed by the coordinate-reflection convention. -/
def higherInvariant (n : ℕ) : CoordinatePolynomial :=
  auxiliaryU ^ n + MvPolynomial.C ((-1 : ℂ) ^ n) * auxiliaryV ^ n

/-- Positive invariant polynomials are the invariants with vanishing constant coefficient. -/
def positiveInvariantPolynomials (n : ℕ) [NeZero n] : Set CoordinatePolynomial :=
  {polynomial | polynomial ∈ invariantSubalgebra n ∧ polynomial.constantCoeff = 0}

/-- The ideal generated by the positive invariants. -/
def coinvariantIdeal (n : ℕ) [NeZero n] : Ideal CoordinatePolynomial :=
  Ideal.span (positiveInvariantPolynomials n)

/-- The coinvariant algebra of the dihedral polynomial action. -/
abbrev CoinvariantAlgebra (n : ℕ) [NeZero n] := CoordinatePolynomial ⧸ coinvariantIdeal n

/-- A positive invariant belongs to the ideal defining the coinvariant algebra. -/
theorem positiveInvariant_mem_coinvariantIdeal (n : ℕ) [NeZero n]
    (polynomial : CoordinatePolynomial) (hpolynomial : polynomial ∈ invariantSubalgebra n)
    (hconstant : polynomial.constantCoeff = 0) : polynomial ∈ coinvariantIdeal n :=
  Ideal.subset_span ⟨hpolynomial, hconstant⟩

/-- The first simple reflection interchanges the auxiliary coordinates with a minus sign. -/
theorem polynomialAction_firstSimple_auxiliaryU (n : ℕ) [NeZero n] :
    polynomialAction n (firstSimpleReflection n) auxiliaryU = -auxiliaryV := by
  rw [firstSimpleReflection, polynomialAction_apply]
  simpa only [polynomialOperator, vectorOperator, ZMod.val_zero, Nat.cast_zero, mul_zero,
    zero_div, neg_zero] using _root_.Schubert.Dihedral.Axial.subst_reflection_u

/-- The first simple reflection sends the second auxiliary coordinate to minus the first. -/
theorem polynomialAction_firstSimple_auxiliaryV (n : ℕ) [NeZero n] :
    polynomialAction n (firstSimpleReflection n) auxiliaryV = -auxiliaryU := by
  rw [firstSimpleReflection, polynomialAction_apply]
  simpa only [polynomialOperator, vectorOperator, ZMod.val_zero, Nat.cast_zero, mul_zero,
    zero_div, neg_zero] using _root_.Schubert.Dihedral.Axial.subst_reflection_v

/-- The positive-angle rotation eigenvalue has order dividing n. -/
theorem rotationEigenvalue_pow_n (n : ℕ) [NeZero n] (exponent : ZMod n) :
    Complex.exp ((((2 * Real.pi * exponent.val / n : ℝ) : ℂ) * Complex.I)) ^ n = 1 := by
  rw [← Complex.exp_nat_mul]
  have hn : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne n)
  have hangle : (n : ℂ) * (((2 * Real.pi * exponent.val / n : ℝ) : ℂ) * Complex.I) =
      exponent.val * (2 * (Real.pi : ℂ) * Complex.I) := by
    push_cast
    field_simp [hn]
  rw [hangle]
  exact Complex.exp_nat_mul_two_pi_mul_I exponent.val

/-- The negative-angle rotation eigenvalue has order dividing n. -/
theorem rotationNegativeEigenvalue_pow_n (n : ℕ) [NeZero n] (exponent : ZMod n) :
    Complex.exp (((-(2 * Real.pi * exponent.val / n) : ℝ) : ℂ) * Complex.I) ^ n = 1 := by
  rw [Complex.ofReal_neg, neg_mul, Complex.exp_neg, inv_pow,
    rotationEigenvalue_pow_n, inv_one]

/-- Every rotation fixes the quadratic invariant candidate. -/
theorem polynomialAction_r_quadraticInvariant (n : ℕ) [NeZero n] (exponent : ZMod n) :
    polynomialAction n (.r exponent) quadraticInvariant = quadraticInvariant := by
  unfold quadraticInvariant
  rw [map_mul, polynomialAction_r_auxiliaryU, polynomialAction_r_auxiliaryV,
    Complex.ofReal_neg, neg_mul, Complex.exp_neg]
  let eigenvalue := Complex.exp (((2 * Real.pi * exponent.val / n : ℝ) : ℂ) * Complex.I)
  change (MvPolynomial.C eigenvalue⁻¹ * auxiliaryU) *
    (MvPolynomial.C eigenvalue * auxiliaryV) = auxiliaryU * auxiliaryV
  calc
    _ = MvPolynomial.C (eigenvalue⁻¹ * eigenvalue) * (auxiliaryU * auxiliaryV) := by
      rw [map_mul]
      ring
    _ = _ := by simp [eigenvalue]

/-- Every rotation fixes the degree-n invariant candidate. -/
theorem polynomialAction_r_higherInvariant (n : ℕ) [NeZero n] (exponent : ZMod n) :
    polynomialAction n (.r exponent) (higherInvariant n) = higherInvariant n := by
  have hconstant := (polynomialAction n (.r exponent)).commutes ((-1 : ℂ) ^ n)
  simp only [MvPolynomial.algebraMap_eq] at hconstant
  have hu : polynomialAction n (.r exponent) (auxiliaryU ^ n) = auxiliaryU ^ n := by
    rw [map_pow, polynomialAction_r_auxiliaryU, mul_pow, ← map_pow,
      rotationNegativeEigenvalue_pow_n]
    simp
  have hv : polynomialAction n (.r exponent) (auxiliaryV ^ n) = auxiliaryV ^ n := by
    rw [map_pow, polynomialAction_r_auxiliaryV, mul_pow, ← map_pow, rotationEigenvalue_pow_n]
    simp
  unfold higherInvariant
  rw [map_add, map_mul, hconstant, hu, hv]

/-- Coordinate reflection fixes the quadratic invariant candidate. -/
theorem _root_.Schubert.Dihedral.Invariants.F2.action_s1 (n : ℕ) [NeZero n] :
    polynomialAction n (firstSimpleReflection n) quadraticInvariant = quadraticInvariant := by
  simp only [quadraticInvariant, map_mul, polynomialAction_firstSimple_auxiliaryU,
    polynomialAction_firstSimple_auxiliaryV, neg_mul_neg]
  exact mul_comm _ _

/-- Coordinate reflection fixes the degree-n invariant candidate for every parity of n. -/
theorem _root_.Schubert.Dihedral.Invariants.Fn.action_s1 (n : ℕ) [NeZero n] :
    polynomialAction n (firstSimpleReflection n) (higherInvariant n) = higherInvariant n := by
  have hconstant := (polynomialAction n (firstSimpleReflection n)).commutes ((-1 : ℂ) ^ n)
  simp only [MvPolynomial.algebraMap_eq] at hconstant
  have hu : polynomialAction n (firstSimpleReflection n) (auxiliaryU ^ n) =
      (-1 : CoordinatePolynomial) ^ n * auxiliaryV ^ n := by
    rw [map_pow, polynomialAction_firstSimple_auxiliaryU, neg_pow]
  have hv : polynomialAction n (firstSimpleReflection n) (auxiliaryV ^ n) =
      (-1 : CoordinatePolynomial) ^ n * auxiliaryU ^ n := by
    rw [map_pow, polynomialAction_firstSimple_auxiliaryV, neg_pow]
  unfold higherInvariant
  rw [map_add, map_mul, hconstant, hu, hv]
  simp only [map_pow, map_neg, map_one]
  have hsquare : ((-1 : CoordinatePolynomial) ^ n) * ((-1) ^ n) = 1 := by
    rw [← mul_pow]
    simp
  calc
    _ = (((-1 : CoordinatePolynomial) ^ n) * ((-1) ^ n)) * auxiliaryU ^ n +
        (-1) ^ n * auxiliaryV ^ n := by ring
    _ = _ := by rw [hsquare]; ring

/-- The quadratic invariant candidate is fixed by the entire dihedral group. -/
theorem _root_.Schubert.Dihedral.Invariants.F2.mem (n : ℕ) [NeZero n] :
    quadraticInvariant ∈ invariantSubalgebra n := by
  rw [mem_invariantSubalgebra]
  intro element
  cases element with
  | r exponent => exact polynomialAction_r_quadraticInvariant n exponent
  | sr exponent =>
    rw [show DihedralGroup.sr exponent = firstSimpleReflection n * .r exponent by
      simp [firstSimpleReflection]]
    rw [map_mul, AlgEquiv.mul_apply, polynomialAction_r_quadraticInvariant,
      _root_.Schubert.Dihedral.Invariants.F2.action_s1]

/-- The degree-n invariant candidate is fixed by the entire dihedral group. -/
theorem higherInvariant_mem_invariantSubalgebra (n : ℕ) [NeZero n] :
    higherInvariant n ∈ invariantSubalgebra n := by
  rw [mem_invariantSubalgebra]
  intro element
  cases element with
  | r exponent => exact polynomialAction_r_higherInvariant n exponent
  | sr exponent =>
    rw [show DihedralGroup.sr exponent = firstSimpleReflection n * .r exponent by
      simp [firstSimpleReflection]]
    rw [map_mul, AlgEquiv.mul_apply, polynomialAction_r_higherInvariant,
      _root_.Schubert.Dihedral.Invariants.Fn.action_s1]

/-- The quadratic generator has vanishing constant coefficient. -/
theorem quadraticInvariant_constantCoeff : quadraticInvariant.constantCoeff = 0 := by
  simp [quadraticInvariant, auxiliaryU, auxiliaryV]

/-- The degree-n generator has vanishing constant coefficient for positive n. -/
theorem higherInvariant_constantCoeff (n : ℕ) [NeZero n] :
    (higherInvariant n).constantCoeff = 0 := by
  simp [higherInvariant, auxiliaryU, auxiliaryV, NeZero.ne n]

/-- The quadratic generator belongs to the coinvariant ideal. -/
theorem quadraticInvariant_mem_coinvariantIdeal (n : ℕ) [NeZero n] :
    quadraticInvariant ∈ coinvariantIdeal n :=
  positiveInvariant_mem_coinvariantIdeal n _ (_root_.Schubert.Dihedral.Invariants.F2.mem n)
    quadraticInvariant_constantCoeff

/-- The degree-n generator belongs to the coinvariant ideal. -/
theorem higherInvariant_mem_coinvariantIdeal (n : ℕ) [NeZero n] :
    higherInvariant n ∈ coinvariantIdeal n :=
  positiveInvariant_mem_coinvariantIdeal n _ (higherInvariant_mem_invariantSubalgebra n)
    (higherInvariant_constantCoeff n)

end Schubert.Dihedral
