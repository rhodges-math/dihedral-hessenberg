import Schubert.Dihedral.CoinvariantIdeal
import Schubert.Dihedral.InvariantDegrees
import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Quotient

/-! # Homogeneity of the dihedral coinvariant ideal

The official coinvariant ideal is generated by the homogeneous invariants of
degrees two and n. Its quotient therefore inherits the standard polynomial grading.
-/

noncomputable section

namespace Schubert.Dihedral

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The coinvariant ideal is homogeneous for the standard polynomial grading. -/
theorem coinvariantIdeal_isHomogeneous (n : ℕ) [NeZero n] (hthree : 3 ≤ n) :
    (coinvariantIdeal n).IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin 2) ℂ) := by
  rw [coinvariantIdeal_eq_span_basicInvariants n hthree]
  apply Ideal.homogeneous_span
  intro polynomial hpolynomial
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hpolynomial
  rcases hpolynomial with rfl | rfl
  · exact ⟨2, quadraticInvariant_isHomogeneous⟩
  · exact ⟨n, higherInvariant_isHomogeneous n⟩

/-- The coinvariant quotient admits the grading by images of homogeneous polynomials. -/
theorem nonempty_coinvariantGradedAlgebra (n : ℕ) [NeZero n] (hthree : 3 ≤ n) :
    Nonempty (GradedAlgebra (TauCeti.GradedAlgebra.quotientPiece
      (MvPolynomial.homogeneousSubmodule (Fin 2) ℂ) (coinvariantIdeal n))) :=
  ⟨TauCeti.GradedAlgebra.gradedAlgebraQuotientPiece _ _
    (coinvariantIdeal_isHomogeneous n hthree)⟩

end Schubert.Dihedral
