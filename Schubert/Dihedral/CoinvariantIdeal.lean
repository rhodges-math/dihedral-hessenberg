import Schubert.Dihedral.InvariantGeneration

/-! # Two generators for the dihedral coinvariant ideal

Generation of the invariant algebra reduces its positive augmentation ideal to the
two basic invariants. This identifies the official coinvariant quotient with the
relations uv = 0 and u^n + (-1)^n*v^n = 0.
-/

noncomputable section

namespace Schubert.Dihedral

/-- Removing the constant term of a polynomial in the basic invariants lands in their ideal. -/
theorem basicInvariant_sub_constant_mem_span (n : ℕ) [NeZero n]
    (polynomial : CoordinatePolynomial)
    (hgenerated : polynomial ∈
      Algebra.adjoin ℂ ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial)) :
    polynomial - MvPolynomial.C polynomial.constantCoeff ∈
      Ideal.span ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial) := by
  let ideal := Ideal.span ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial)
  induction hgenerated using Algebra.adjoin_induction with
  | mem polynomial hpolynomial =>
    have hconstant : polynomial.constantCoeff = 0 := by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hpolynomial
      rcases hpolynomial with rfl | rfl
      · exact quadraticInvariant_constantCoeff
      · exact higherInvariant_constantCoeff n
    rw [hconstant, map_zero, sub_zero]
    exact Ideal.subset_span hpolynomial
  | algebraMap scalar =>
    change MvPolynomial.C scalar -
      MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.C scalar)) ∈ ideal
    simp only [MvPolynomial.constantCoeff_C, sub_self]
    exact ideal.zero_mem
  | add first second _ _ hfirst hsecond =>
    simp only [map_add]
    have hequal : first + second -
        (MvPolynomial.C first.constantCoeff + MvPolynomial.C second.constantCoeff) =
        (first - MvPolynomial.C first.constantCoeff) +
          (second - MvPolynomial.C second.constantCoeff) := by ring
    rw [hequal]
    exact ideal.add_mem hfirst hsecond
  | mul first second _ _ hfirst hsecond =>
    simp only [map_mul]
    have hequal : first * second -
        MvPolynomial.C first.constantCoeff * MvPolynomial.C second.constantCoeff =
        first * (second - MvPolynomial.C second.constantCoeff) +
          (first - MvPolynomial.C first.constantCoeff) * MvPolynomial.C second.constantCoeff :=
      by ring
    rw [hequal]
    exact ideal.add_mem (ideal.mul_mem_left _ hsecond) (ideal.mul_mem_right _ hfirst)

/-- The coinvariant ideal is generated by the two basic invariants. -/
theorem coinvariantIdeal_eq_span_basicInvariants (n : ℕ) [NeZero n] (hthree : 3 ≤ n) :
    coinvariantIdeal n =
      Ideal.span ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial) := by
  apply le_antisymm
  · rw [coinvariantIdeal, Ideal.span_le]
    intro polynomial hpolynomial
    have hgenerated : polynomial ∈ Algebra.adjoin ℂ
        ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial) := by
      rw [← _root_.Schubert.Dihedral.Invariants.eq_generator_adjoin n hthree]
      exact hpolynomial.1
    have hresult := basicInvariant_sub_constant_mem_span n polynomial hgenerated
    rw [hpolynomial.2, map_zero, sub_zero] at hresult
    change polynomial ∈ Ideal.span
      ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial)
    exact hresult
  · rw [Ideal.span_le]
    intro polynomial hpolynomial
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hpolynomial
    rcases hpolynomial with rfl | rfl
    · exact quadraticInvariant_mem_coinvariantIdeal n
    · exact higherInvariant_mem_coinvariantIdeal n

end Schubert.Dihedral
