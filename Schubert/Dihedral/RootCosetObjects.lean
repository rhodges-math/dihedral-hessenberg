import Schubert.Dihedral.RootObjects
import Schubert.Dihedral.ReflectionCosetCharacters

/-! # Standard cosets and permutation representations of root reflections -/

noncomputable section

namespace Schubert.Dihedral.PositiveRoot

/-- The subgroup generated by the reflection in a positive vector. -/
def subgroup {n : ℕ} (alpha : PositiveRoot n) : Subgroup (DihedralGroup n) :=
  Subgroup.closure {alpha.reflection}

/-- The standard left cosets of the root-reflection subgroup. -/
abbrev Cosets {n : ℕ} (alpha : PositiveRoot n) := DihedralGroup n ⧸ alpha.subgroup

/-- The standard permutation representation of the root-reflection cosets. -/
def cosetRepresentation {n : ℕ} (alpha : PositiveRoot n) :
    Representation ℂ (DihedralGroup n) (MonoidAlgebra ℂ alpha.Cosets) :=
  Representation.ofMulAction ℂ (DihedralGroup n) alpha.Cosets

/-- Root numbering preserves the generating subgroup exactly. -/
theorem subgroup_index {n : ℕ} (alpha : PositiveRoot n) :
    alpha.subgroup = rootReflectionSubgroup alpha.index := rfl

/-- Root numbering preserves the standard coset permutation representation. -/
theorem cosetRepresentation_index {n : ℕ} (alpha : PositiveRoot n) :
    alpha.cosetRepresentation = rootReflectionCosetRepresentation alpha.index := rfl

/-- A root reflection generates a subgroup of order two. -/
theorem card_subgroup {n : ℕ} (alpha : PositiveRoot n) : Nat.card alpha.subgroup = 2 :=
  card_rootReflectionSubgroup alpha.index

/-- The root-reflection subgroup has n standard left cosets. -/
theorem card_cosets {n : ℕ} [NeZero n] (alpha : PositiveRoot n) : Nat.card alpha.Cosets = n :=
  card_rootReflectionCosets alpha.index

/-- The coset permutation character equals the fixed-coset count. -/
theorem coset_character {n : ℕ} [NeZero n] (alpha : PositiveRoot n)
    (element : DihedralGroup n) :
    alpha.cosetRepresentation.character element =
      (Nat.card (MulAction.fixedBy alpha.Cosets element) : ℂ) :=
  _root_.Schubert.Dihedral.IndexedReflectionCosets.character alpha.index element

/-- The root-coset permutation character is n at the identity. -/
theorem coset_character_one {n : ℕ} [NeZero n] (alpha : PositiveRoot n) :
    alpha.cosetRepresentation.character 1 = (n : ℂ) :=
  _root_.Schubert.Dihedral.IndexedReflectionCosets.character_one alpha.index

/-- Nonidentity rotations have zero root-coset permutation character. -/
theorem coset_character_rotation {n : ℕ} [NeZero n] (alpha : PositiveRoot n)
    (coordinate : ZMod n) (hne : coordinate ≠ 0) :
    alpha.cosetRepresentation.character (DihedralGroup.r coordinate) = 0 :=
  _root_.Schubert.Dihedral.IndexedReflectionCosets.character_r alpha.index coordinate hne

/-- Every reflection has root-coset permutation character one when n is odd. -/
theorem coset_character_odd {n : ℕ} [NeZero n] (alpha : PositiveRoot n)
    (hodd : Odd n) (coordinate : ZMod n) :
    alpha.cosetRepresentation.character (DihedralGroup.sr coordinate) = 1 :=
  _root_.Schubert.Dihedral.IndexedReflectionCosets.character_sr_odd alpha.index hodd coordinate

/-- For even n the root-coset character distinguishes the two reflection classes. -/
theorem coset_character_even {n : ℕ} [NeZero n] (alpha : PositiveRoot n)
    (heven : Even n) (coordinate : ZMod n) :
    alpha.cosetRepresentation.character (DihedralGroup.sr coordinate) =
      if IsConj (DihedralGroup.sr coordinate) alpha.reflection then 2 else 0 :=
  _root_.Schubert.Dihedral.IndexedReflectionCosets.character_sr_even alpha.index heven coordinate

end Schubert.Dihedral.PositiveRoot
