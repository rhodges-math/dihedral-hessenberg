import Schubert.Dihedral.CoxeterSystem

/-! # Canonical right weak order and reduced prefixes -/

namespace Schubert.Dihedral

/-- Right weak order is the additive-length prefix relation for the canonical Coxeter system. -/
def RightWeakLE (n : ℕ) (hthree : 3 ≤ n) (source target : DihedralGroup n) : Prop :=
  length n hthree source + length n hthree (source⁻¹ * target) = length n hthree target

/-- Right weak order means that a reduced expression of the target has a reduced source prefix. -/
theorem rightWeakLE_prefix (n : ℕ) (hthree : 3 ≤ n) (source target : DihedralGroup n) :
    RightWeakLE n hthree source target ↔
      ∃ first second : List (Fin 2), (coxeterSystem n hthree).IsReduced (first ++ second) ∧
        source = (coxeterSystem n hthree).wordProd first ∧
        target = (coxeterSystem n hthree).wordProd (first ++ second) := by
  let cs := coxeterSystem n hthree
  constructor
  · intro hweak
    obtain ⟨first, hfirst, hsource⟩ := cs.exists_isReduced source
    obtain ⟨second, hsecond, htail⟩ := cs.exists_isReduced (source⁻¹ * target)
    have htarget : target = cs.wordProd (first ++ second) := by
      rw [cs.wordProd_append, ← hsource, ← htail]
      group
    refine ⟨first, second, ?_, hsource, htarget⟩
    change cs.length (cs.wordProd (first ++ second)) = (first ++ second).length
    change cs.length source + cs.length (source⁻¹ * target) = cs.length target at hweak
    rw [← htarget, ← hweak, htail, hsource, hfirst.eq, hsecond.eq, List.length_append]
  · rintro ⟨first, second, hword, hsource, htarget⟩
    have hfirst := hword.take first.length
    have hsecond := hword.drop first.length
    simp only [List.take_left, List.drop_left] at hfirst hsecond
    change cs.length source + cs.length (source⁻¹ * target) = cs.length target
    rw [hsource, htarget, cs.wordProd_append, inv_mul_cancel_left,
      hfirst.eq, hsecond.eq]
    rw [← cs.wordProd_append, hword.eq, List.length_append]

private theorem word_path (n : ℕ) (hthree : 3 ≤ n) (source : DihedralGroup n)
    (word : List (Fin 2))
    (hadd : (coxeterSystem n hthree).length
      (source * (coxeterSystem n hthree).wordProd word) =
      (coxeterSystem n hthree).length source + word.length) :
    Relation.ReflTransGen (fun first second => ∃ simple : Fin 2,
      second = first * (coxeterSystem n hthree).simple simple ∧
        (coxeterSystem n hthree).length first < (coxeterSystem n hthree).length second)
      source (source * (coxeterSystem n hthree).wordProd word) := by
  let cs := coxeterSystem n hthree
  induction word generalizing source with
  | nil =>
    rw [CoxeterSystem.wordProd_nil, mul_one]
  | cons simple word ih =>
    have hprefix_le := cs.length_mul_le source (cs.simple simple)
    rw [cs.length_simple] at hprefix_le
    have htail_le := cs.length_mul_le (source * cs.simple simple) (cs.wordProd word)
    have hword_le := cs.length_wordProd_le word
    rw [cs.wordProd_cons, ← mul_assoc, List.length_cons] at hadd
    have hprefix : cs.length (source * cs.simple simple) = cs.length source + 1 := by
      dsimp only [cs] at *
      omega
    have htail : cs.length ((source * cs.simple simple) * cs.wordProd word) =
        cs.length (source * cs.simple simple) + word.length := by
      dsimp only [cs] at *
      omega
    have hstep : Relation.ReflTransGen (fun first second => ∃ i : Fin 2,
        second = first * cs.simple i ∧ cs.length first < cs.length second)
        source (source * cs.simple simple) :=
      Relation.ReflTransGen.tail .refl ⟨simple, rfl, by omega⟩
    rw [CoxeterSystem.wordProd_cons, ← mul_assoc]
    exact hstep.trans (ih _ htail)

/-- Canonical right weak order is generated by increasing right simple-reflection steps. -/
theorem rightWeakLE_path (n : ℕ) (hthree : 3 ≤ n) (source target : DihedralGroup n) :
    RightWeakLE n hthree source target ↔
      Relation.ReflTransGen (fun first second => ∃ simple : Fin 2,
        second = first * (coxeterSystem n hthree).simple simple ∧
          (coxeterSystem n hthree).length first < (coxeterSystem n hthree).length second)
        source target := by
  let cs := coxeterSystem n hthree
  constructor
  · intro hweak
    obtain ⟨word, hword, hprod⟩ := cs.exists_isReduced (source⁻¹ * target)
    have htarget : source * cs.wordProd word = target := by rw [← hprod]; group
    have hadd : cs.length (source * cs.wordProd word) = cs.length source + word.length := by
      change cs.length source + cs.length (source⁻¹ * target) = cs.length target at hweak
      rw [htarget, ← hword.eq, ← hprod]
      exact hweak.symm
    exact htarget ▸ word_path n hthree source word hadd
  · intro hpath
    change cs.length source + cs.length (source⁻¹ * target) = cs.length target
    induction hpath with
    | refl => rw [inv_mul_cancel, cs.length_one, add_zero]
    | @tail previous next hpath hedge ih =>
      obtain ⟨simple, rfl, hlt⟩ := hedge
      change cs.length previous < cs.length (previous * cs.simple simple) at hlt
      have hnext : cs.length (previous * cs.simple simple) = cs.length previous + 1 :=
        (cs.length_mul_simple previous simple).resolve_right (by omega)
      have htail := cs.length_mul_le (source⁻¹ * previous) (cs.simple simple)
      rw [mul_assoc, cs.length_simple] at htail
      have hbound := cs.length_mul_le source (source⁻¹ * (previous * cs.simple simple))
      rw [mul_inv_cancel_left] at hbound
      dsimp only [cs] at *
      omega

end Schubert.Dihedral
