import Schubert.DihedralSplines.RootConjugateEdge
import Mathlib.Logic.Relation

/-! # The length orientation and reachability order of Hessenberg endpoint graphs -/

namespace Schubert.Dihedral.RootSubset

/-- Endpoint edges directed from smaller to larger canonical length. -/
def orientedEdges {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n) :
    Set (DihedralGroup n × DihedralGroup n) :=
  {pair | pair ∈ selected.edges ∧
    Schubert.Dihedral.length n hthree pair.1 < Schubert.Dihedral.length n hthree pair.2}

/-- Reachability is the reflexive transitive closure of the oriented endpoint relation. -/
def reachable {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n) :
    DihedralGroup n → DihedralGroup n → Prop :=
  Relation.ReflTransGen (fun source target => (source, target) ∈ selected.orientedEdges hthree)

/-- A directed path is constant or strictly increases canonical length. -/
theorem reachable_eq_or_lt {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n)
    {source target : DihedralGroup n} (hpath : selected.reachable hthree source target) :
    source = target ∨
      Schubert.Dihedral.length n hthree source < Schubert.Dihedral.length n hthree target := by
  induction hpath with
  | refl => exact Or.inl rfl
  | tail previous hedge ih =>
    right
    rcases ih with heq | hlt
    · rw [heq]
      exact hedge.2
    · exact hlt.trans hedge.2

/-- Oriented reachability is antisymmetric. -/
theorem reachable_antisymm {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n)
    {source target : DihedralGroup n} (hforward : selected.reachable hthree source target)
    (hbackward : selected.reachable hthree target source) : source = target := by
  rcases selected.reachable_eq_or_lt hthree hforward with heq | hlt
  · exact heq
  rcases selected.reachable_eq_or_lt hthree hbackward with heq | hgt
  · exact heq.symm
  · omega

/-- The canonical partial order generated by the selected oriented graph. -/
@[instance_reducible] def partialOrder {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n) :
    PartialOrder (DihedralGroup n) where
  le := selected.reachable hthree
  le_refl _ := Relation.ReflTransGen.refl
  le_trans _ _ _ := Relation.ReflTransGen.trans
  le_antisymm _ _ := selected.reachable_antisymm hthree

/-- Every nonempty directed path strictly increases canonical length. -/
theorem directed_length_lt {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n)
    {source target : DihedralGroup n}
    (hpath : Relation.TransGen
      (fun first second => (first, second) ∈ selected.orientedEdges hthree) source target) :
    Schubert.Dihedral.length n hthree source < Schubert.Dihedral.length n hthree target := by
  induction hpath with
  | single hedge => exact hedge.2
  | tail previous hedge ih => exact ih.trans hedge.2

/-- Strict reachability is precisely the transitive closure of the oriented edges. -/
theorem reachable_strict_iff {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n)
    (source target : DihedralGroup n) :
    (selected.reachable hthree source target ∧ source ≠ target) ↔
      Relation.TransGen
        (fun first second => (first, second) ∈ selected.orientedEdges hthree) source target := by
  constructor
  · rintro ⟨hpath, hne⟩
    rcases Relation.reflTransGen_iff_eq_or_transGen.mp hpath with heq | hstrict
    · exact (hne heq.symm).elim
    · exact hstrict
  · intro hpath
    refine ⟨hpath.to_reflTransGen, ?_⟩
    have hlength := selected.directed_length_lt hthree hpath
    intro heq
    rw [heq] at hlength
    exact (lt_irrefl _ hlength)

/-- Every directed path follows canonical Bruhat order. -/
theorem reachable_bruhat {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n)
    {source target : DihedralGroup n} (hpath : selected.reachable hthree source target) :
    BruhatLE n hthree source target := by
  rcases selected.reachable_eq_or_lt hthree hpath with heq | hlt
  · subst target
    exact bruhatLE_refl n hthree source
  · exact bruhatLE_of_length_lt n hthree hlt

/-- The strict part of the generated partial order is exactly nonempty directed reachability. -/
theorem partialOrder_lt {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n)
    (source target : DihedralGroup n) :
    @LT.lt (DihedralGroup n) (selected.partialOrder hthree).toLT source target ↔
      Relation.TransGen
        (fun first second => (first, second) ∈ selected.orientedEdges hthree) source target := by
  change (selected.reachable hthree source target ∧
    ¬selected.reachable hthree target source) ↔ _
  constructor
  · rintro ⟨hforward, hbackward⟩
    apply (selected.reachable_strict_iff hthree source target).mp
    refine ⟨hforward, ?_⟩
    intro heq
    subst target
    exact hbackward Relation.ReflTransGen.refl
  · intro hpath
    obtain ⟨hforward, hne⟩ := (selected.reachable_strict_iff hthree source target).mpr hpath
    exact ⟨hforward, fun hbackward => hne
      (selected.reachable_antisymm hthree hforward hbackward)⟩

/-- No vertex admits a nonempty directed cycle. -/
theorem acyclic {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n)
    (vertex : DihedralGroup n) :
    ¬Relation.TransGen
      (fun first second => (first, second) ∈ selected.orientedEdges hthree) vertex vertex := by
  intro hpath
  exact lt_irrefl _ (selected.directed_length_lt hthree hpath)

/-- In-degree in the acyclic orientation equals the number of selected inversions. -/
theorem incoming_card {n : ℕ} (hthree : 3 ≤ n) (selected : RootSubset n)
    (target : DihedralGroup n) :
    {source : DihedralGroup n | (source, target) ∈ selected.orientedEdges hthree}.ncard =
      selected.length target := by
  have hset : {source : DihedralGroup n | (source, target) ∈ selected.orientedEdges hthree} =
      {source : DihedralGroup n | (target, source) ∈ selected.edges ∧
        Schubert.Dihedral.length n hthree source < Schubert.Dihedral.length n hthree target} := by
    ext source
    constructor
    · intro hedge
      exact ⟨selected.edge_symm hedge.1, hedge.2⟩
    · intro hedge
      exact ⟨selected.edge_symm hedge.1, hedge.2⟩
  rw [hset]
  exact selected.descending_card hthree target

end Schubert.Dihedral.RootSubset
