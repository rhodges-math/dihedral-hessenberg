import Schubert.Dihedral.Realization

/-! # Hessenberg ideals in the dihedral root system

The root relation compares the difference of two real positive roots in the nonnegative
cone spanned by the simple roots. Hessenberg ideals contain both simple-root indices.
-/

noncomputable section

namespace Schubert.DihedralSplines

open Schubert.Dihedral

/-- Comparison of positive roots by the real cone generated by the two simple roots. -/
def RootLE (n : ℕ) (hthree : 3 ≤ n) (first second : PositiveRootIndex n) : Prop :=
  ∃ firstCoefficient secondCoefficient : ℝ,
    0 ≤ firstCoefficient ∧ 0 ≤ secondCoefficient ∧
      positiveRoot n second - positiveRoot n first =
        firstCoefficient • positiveRoot n (firstSimpleRootIndex n hthree) +
          secondCoefficient • positiveRoot n (secondSimpleRootIndex n hthree)

/-- A lower ideal in the real root relation containing both simple roots. -/
structure HessenbergSpace (n : ℕ) (hthree : 3 ≤ n) where
  /-- The finite set of positive-root indices in the ideal. -/
  roots : Finset (PositiveRootIndex n)
  /-- Every positive root below a member also belongs to the ideal. -/
  lower : ∀ ⦃first second⦄, RootLE n hthree first second → second ∈ roots → first ∈ roots
  /-- The first simple root belongs to the ideal. -/
  first_mem : firstSimpleRootIndex n hthree ∈ roots
  /-- The second simple root belongs to the ideal. -/
  second_mem : secondSimpleRootIndex n hthree ∈ roots

end Schubert.DihedralSplines
