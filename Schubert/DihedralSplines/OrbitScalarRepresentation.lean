import Schubert.DihedralSplines.SplineScalarAction
import Schubert.DihedralSplines.PaperCoordinates
import Schubert.Dihedral.PolynomialPieceRepresentation
import TauCeti.RepresentationTheory.AsModule

/-! # The orbit-coordinate scalar subalgebra and its action -/

noncomputable section
open CategoryTheory Limits
namespace Schubert.Dihedral.RootSubset.Right

variable {n : ℕ} [NeZero n] (selected : RootSubset n) (hthree : 3 ≤ n)

/-- The orbit polynomial embedding is an equivalence onto its range. -/
def scalarEquiv : CoordinatePolynomial ≃ₐ[ℂ] (selected.orbitHom hthree).range :=
  AlgEquiv.ofInjective (selected.orbitHom hthree) (selected.orbitHom_injective hthree)

omit [NeZero n] in
/-- The orbit range is exactly the subalgebra generated by the two orbit coordinates. -/
theorem scalar_range : (selected.orbitHom hthree).range =
    Algebra.adjoin ℂ {selected.xRight hthree, selected.yRight hthree} := by
  rw [selected.orbitHom_aeval, MvPolynomial.aeval_range]
  congr 1
  ext value
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨coordinate, rfl⟩
    fin_cases coordinate <;> simp [xRight, yRight]
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

/-- Dot translation fixes every orbit polynomial. -/
theorem dot_orbit (element : DihedralGroup n) (polynomial : CoordinatePolynomial) :
    selected.splineRepresentation hthree element (selected.orbitHom hthree polynomial) =
      selected.orbitHom hthree polynomial := by
  let := selected.rightAlgebra hthree
  have hscalar := selected.right_smul_dot hthree element polynomial (1 : selected.Spline)
  change (selected.dotEquiv hthree element) (selected.orbitHom hthree polynomial * 1) =
    selected.orbitHom hthree polynomial * (selected.dotEquiv hthree element) 1 at hscalar
  change (selected.dotEquiv hthree element) _ = _
  simpa using hscalar

/-- Restriction of the spline action to the orbit scalar subalgebra. -/
def scalarRepresentation : Representation ℂ (DihedralGroup n) (selected.orbitHom hthree).range :=
  (selected.splineRepresentation hthree).subrepresentation
    (selected.orbitHom hthree).range.toSubmodule (fun element value hvalue => by
      obtain ⟨polynomial, hpolynomial⟩ := hvalue
      refine ⟨polynomial, ?_⟩
      exact (dot_orbit selected hthree element polynomial).symm.trans
        (congrArg (selected.splineRepresentation hthree element) hpolynomial))

/-- The orbit scalar action is equivalent to the trivial polynomial action. -/
def scalarActionEquiv : Representation.Equiv
    (Representation.trivial ℂ (DihedralGroup n) CoordinatePolynomial)
    (scalarRepresentation selected hthree) := by
  refine Representation.Equiv.mk (scalarEquiv selected hthree).toLinearEquiv ?_
  intro element
  apply LinearMap.ext
  intro polynomial
  apply Subtype.ext
  change selected.orbitHom hthree polynomial =
    selected.splineRepresentation hthree element (selected.orbitHom hthree polynomial)
  exact (dot_orbit selected hthree element polynomial).symm

/-- The orbit scalar subalgebra intersected with one spline degree. -/
@[instance_reducible] def scalarPiece (degree : ℕ) : Submodule ℂ (selected.orbitHom hthree).range :=
  (selected.piece degree).comap (selected.orbitHom hthree).range.val.toLinearMap

/-- Orbit polynomial evaluation identifies its homogeneous scalar piece. -/
def scalarPieceEquiv (degree : ℕ) :
    MvPolynomial.homogeneousSubmodule (Fin 2) ℂ degree ≃ₗ[ℂ]
      scalarPiece selected hthree degree where
  toFun value := ⟨scalarEquiv selected hthree value.val,
    selected.orbitHom_mem_piece hthree degree value.val value.property⟩
  invFun value := ⟨(value.val.val : DihedralGroup n → CoordinatePolynomial) 1,
    value.property 1⟩
  left_inv value := by
    apply Subtype.ext
    change polynomialAction n 1 value.val = value.val
    rw [map_one]
    rfl
  right_inv value := by
    apply Subtype.ext
    apply Subtype.ext
    obtain ⟨polynomial, hpolynomial⟩ := value.val.property
    change selected.orbitHom hthree
      ((value.val.val : DihedralGroup n → CoordinatePolynomial) 1) = value.val.val
    have hevaluation : (value.val.val : DihedralGroup n → CoordinatePolynomial) 1 = polynomial := by
      rw [← hpolynomial]
      change polynomialAction n 1 polynomial = polynomial
      rw [map_one]
      rfl
    rw [hevaluation]
    exact hpolynomial
  map_add' first second := by
    apply Subtype.ext
    exact (scalarEquiv selected hthree).map_add first.val second.val
  map_smul' scalar value := by
    apply Subtype.ext
    exact (scalarEquiv selected hthree).toLinearEquiv.map_smul scalar value.val

/-- The orbit scalar action restricted to its homogeneous degree. -/
def scalarPieceRepresentation (degree : ℕ) :
    Representation ℂ (DihedralGroup n) (scalarPiece selected hthree degree) :=
  (scalarRepresentation selected hthree).subrepresentation (scalarPiece selected hthree degree)
    (fun element value hvalue => selected.dot_mem_piece hthree element degree value.val hvalue)

/-- The orbit scalar degree action is the trivial polynomial degree action. -/
def scalarPieceActionEquiv (degree : ℕ) : Representation.Equiv
    (Representation.trivial ℂ (DihedralGroup n)
      (MvPolynomial.homogeneousSubmodule (Fin 2) ℂ degree))
    (scalarPieceRepresentation selected hthree degree) := by
  refine Representation.Equiv.mk (scalarPieceEquiv selected hthree degree) ?_
  intro element
  apply LinearMap.ext
  intro polynomial
  apply Subtype.ext
  apply Subtype.ext
  change selected.orbitHom hthree polynomial.val =
    selected.splineRepresentation hthree element (selected.orbitHom hthree polynomial.val)
  exact (dot_orbit selected hthree element polynomial.val).symm

/-- The finite orbit scalar degree action as a standard representation object. -/
def scalarPieceFDRep (degree : ℕ) : FDRep ℂ (DihedralGroup n) := by
  let : AddCommGroup (selected.orbitHom hthree).range :=
    Submodule.addCommGroup (selected.orbitHom hthree).range.toSubmodule
  let : Module ℂ (selected.orbitHom hthree).range :=
    Submodule.module (selected.orbitHom hthree).range.toSubmodule
  let : AddCommGroup (scalarPiece selected hthree degree) :=
    Submodule.addCommGroup (scalarPiece selected hthree degree)
  let : Module ℂ (scalarPiece selected hthree degree) :=
    Submodule.module (scalarPiece selected hthree degree)
  let : Module.Finite ℂ (scalarPiece selected hthree degree) := Module.Finite.of_surjective
    (scalarPieceEquiv selected hthree degree).toLinearMap
    (scalarPieceEquiv selected hthree degree).surjective
  exact FDRep.of (V := scalarPiece selected hthree degree)
    (scalarPieceRepresentation selected hthree degree)

/-- The orbit scalar degree is a sum of degree plus one trivial representations. -/
theorem scalarPiece_iso (degree : ℕ) : Nonempty (scalarPieceFDRep selected hthree degree ≅
    ⨁ fun _ : Fin (degree + 1) => FDRep.of (Representation.trivial ℂ (DihedralGroup n) ℂ)) := by
  have hfirst : Nonempty (scalarPieceFDRep selected hthree degree ≅
      trivialPolynomialPiece n degree) := by
    apply TauCeti.nonempty_fdRepIso_iff.mpr
    exact ⟨(scalarPieceActionEquiv selected hthree degree).symm⟩
  exact ⟨hfirst.some.trans (trivialPolynomialPiece_iso n degree).some⟩

end Schubert.Dihedral.RootSubset.Right
