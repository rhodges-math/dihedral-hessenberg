import Schubert.DihedralSplines.Spline
import Schubert.Splines.Quotient
import Mathlib.Tactic.FinCases

/-! # The left and right Hessenberg spline quotient algebras

The variable ideals of the dihedral reflection data give the two concrete
quotients in the paper. Their generators are exactly the constant and orbit coordinate
splines. This file provides the defining quotient maps and coordinate-zero relations.
-/

noncomputable section

namespace Schubert.DihedralSplines

open Schubert.Dihedral Schubert.Splines

variable {n : ℕ} {hthree : 3 ≤ n} (ideal : HessenbergSpace n hthree)

/-- The ideal generated by the two constant coordinate splines. -/
def leftHessenbergIdeal : Ideal (HessenbergSpline ideal) :=
  (dihedralReflectionData n hthree).leftVariableIdeal (ideal.roots : Set (PositiveRootIndex n))

/-- The ideal generated by the two orbit coordinate splines. -/
def rightHessenbergIdeal : Ideal (HessenbergSpline ideal) :=
  (dihedralReflectionData n hthree).rightVariableIdeal (ideal.roots : Set (PositiveRootIndex n))

private theorem range_finTwo {A : Type*} (value : Fin 2 → A) :
    Set.range value = {value 0, value 1} := by
  ext element
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨index, rfl⟩
    fin_cases index <;> simp
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

/-- The left defining ideal has precisely the paper's two coordinate generators. -/
theorem leftHessenbergIdeal_eq_span :
    leftHessenbergIdeal ideal = Ideal.span {
      (dihedralReflectionData n hthree).constantSpline (ideal.roots : Set (PositiveRootIndex n))
        (MvPolynomial.X (0 : Fin 2)),
      (dihedralReflectionData n hthree).constantSpline (ideal.roots : Set (PositiveRootIndex n))
        (MvPolynomial.X (1 : Fin 2))} := by
  rw [leftHessenbergIdeal, ReflectionGraphData.leftVariableIdeal_eq_span, range_finTwo]

/-- The right defining ideal has precisely the paper's two coordinate generators. -/
theorem rightHessenbergIdeal_eq_span :
    rightHessenbergIdeal ideal = Ideal.span {
      (dihedralReflectionData n hthree).orbitSpline (ideal.roots : Set (PositiveRootIndex n))
        (MvPolynomial.X (0 : Fin 2)),
      (dihedralReflectionData n hthree).orbitSpline (ideal.roots : Set (PositiveRootIndex n))
        (MvPolynomial.X (1 : Fin 2))} := by
  rw [rightHessenbergIdeal, ReflectionGraphData.rightVariableIdeal_eq_span, range_finTwo]

/-- The left quotient of a dihedral Hessenberg spline algebra. -/
abbrev LeftHessenbergQuotient := HessenbergSpline ideal ⧸ leftHessenbergIdeal ideal

/-- The right quotient of a dihedral Hessenberg spline algebra. -/
abbrev RightHessenbergQuotient := HessenbergSpline ideal ⧸ rightHessenbergIdeal ideal

/-- The canonical complex algebra map onto the left Hessenberg quotient. -/
def leftHessenbergQuotientMap : HessenbergSpline ideal →ₐ[ℂ] LeftHessenbergQuotient ideal :=
  Ideal.Quotient.mkₐ ℂ (leftHessenbergIdeal ideal)

/-- The canonical complex algebra map onto the right Hessenberg quotient. -/
def rightHessenbergQuotientMap : HessenbergSpline ideal →ₐ[ℂ] RightHessenbergQuotient ideal :=
  Ideal.Quotient.mkₐ ℂ (rightHessenbergIdeal ideal)

/-- Every constant coordinate spline is zero in the left Hessenberg quotient. -/
theorem leftHessenbergQuotientMap_coordinate (coordinate : Fin 2) :
    leftHessenbergQuotientMap ideal
      ((dihedralReflectionData n hthree).constantSpline
        (ideal.roots : Set (PositiveRootIndex n)) (MvPolynomial.X coordinate)) = 0 :=
  (dihedralReflectionData n hthree).leftQuotientMap_coordinate
    (ideal.roots : Set (PositiveRootIndex n)) coordinate

/-- Every orbit coordinate spline is zero in the right Hessenberg quotient. -/
theorem rightHessenbergQuotientMap_coordinate (coordinate : Fin 2) :
    rightHessenbergQuotientMap ideal
      ((dihedralReflectionData n hthree).orbitSpline
        (ideal.roots : Set (PositiveRootIndex n)) (MvPolynomial.X coordinate)) = 0 :=
  (dihedralReflectionData n hthree).rightQuotientMap_coordinate
    (ideal.roots : Set (PositiveRootIndex n)) coordinate

end Schubert.DihedralSplines
