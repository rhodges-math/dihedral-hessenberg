import DihedralHessenberg.Dihedral.ReflectionIndex
import Mathlib.GroupTheory.Coset.Card
import Mathlib.Data.ZMod.QuotientGroup

/-! # Standard reflection subgroups and their coset cardinality -/

namespace Schubert.Dihedral

/-- A reflection generates the two-element subgroup consisting of the identity and itself. -/
theorem mem_closure_sr_iff (n : ℕ) [NeZero n] (coordinate : ZMod n)
    (element : DihedralGroup n) :
    element ∈ Subgroup.closure {DihedralGroup.sr coordinate} ↔
      element = 1 ∨ element = DihedralGroup.sr coordinate := by
  rw [← Subgroup.zpowers_eq_closure,
    (isOfFinOrder_of_finite (DihedralGroup.sr coordinate)).mem_zpowers_iff_mem_range_orderOf,
    DihedralGroup.orderOf_sr]
  norm_num [eq_comm]
  constructor
  · rintro ⟨power, hpower, hvalue⟩
    have hcases : power = 0 ∨ power = 1 := by omega
    rcases hcases with rfl | rfl
    · exact Or.inl (by simpa only [pow_zero] using hvalue)
    · exact Or.inr (by simpa only [pow_one] using hvalue)
  · rintro (hone | hreflection)
    · exact ⟨0, by omega, by simpa only [pow_zero] using hone⟩
    · exact ⟨1, by omega, by simpa only [pow_one] using hreflection⟩

/-- The standard subgroup generated by a reflection has cardinality two. -/
theorem card_closure_sr (n : ℕ) (coordinate : ZMod n) :
    Nat.card (Subgroup.closure {DihedralGroup.sr coordinate}) = 2 := by
  rw [← Subgroup.zpowers_eq_closure, Nat.card_zpowers, DihedralGroup.orderOf_sr]

/-- The standard cosets of a reflection subgroup have cardinality n. -/
theorem card_quotient_closure_sr (n : ℕ) [NeZero n] (coordinate : ZMod n) :
    Nat.card (DihedralGroup n ⧸ Subgroup.closure {DihedralGroup.sr coordinate}) = n := by
  have hcard := Subgroup.card_eq_card_quotient_mul_card_subgroup
    (Subgroup.closure {DihedralGroup.sr coordinate})
  rw [card_closure_sr, Nat.card_eq_fintype_card, DihedralGroup.card] at hcard
  omega

end Schubert.Dihedral

