import DihedralHessenberg.Dihedral.InvariantCoefficients
import DihedralHessenberg.Dihedral.InvariantOrbitPairs

/-! # Generation of the dihedral invariant algebra

The auxiliary expansion of an invariant contains only rotation-resonant monomials.
Reflection symmetrization expresses it as a sum of pairs generated by uv and the
signed degree-n power sum.
-/

noncomputable section

namespace Schubert.Dihedral

/-- The auxiliary coordinate equivalence sends an ordinary monomial to its u,v expression. -/
theorem auxiliaryCoordinateEquiv_monomial (exponent : Fin 2 →₀ ℕ) (scalar : ℂ) :
    auxiliaryCoordinateEquiv (MvPolynomial.monomial exponent scalar) =
      MvPolynomial.C scalar * auxiliaryU ^ exponent 0 * auxiliaryV ^ exponent 1 := by
  rw [MvPolynomial.monomial_fin_two]
  simp only [map_mul, map_pow, auxiliaryCoordinateEquiv_X_zero,
    auxiliaryCoordinateEquiv_X_one]
  have hconstant : auxiliaryCoordinateEquiv (MvPolynomial.C scalar) = MvPolynomial.C scalar :=
    auxiliaryCoordinateEquiv.commutes scalar
  rw [hconstant]

/-- Reflection symmetrizes an auxiliary monomial with the prescribed parity sign. -/
theorem auxiliary_monomial_reflection_sum (n : ℕ) [NeZero n] (first second : ℕ)
    (scalar : ℂ) :
    MvPolynomial.C scalar * auxiliaryU ^ first * auxiliaryV ^ second +
        polynomialAction n (firstSimpleReflection n)
          (MvPolynomial.C scalar * auxiliaryU ^ first * auxiliaryV ^ second) =
      MvPolynomial.C scalar * (auxiliaryU ^ first * auxiliaryV ^ second +
        MvPolynomial.C ((-1 : ℂ) ^ (first + second)) *
          auxiliaryU ^ second * auxiliaryV ^ first) := by
  rw [map_mul, map_mul, map_pow, map_pow, polynomialAction_firstSimple_auxiliaryU,
    polynomialAction_firstSimple_auxiliaryV, neg_pow auxiliaryV first,
    neg_pow auxiliaryU second, pow_add]
  have hconstant : polynomialAction n (firstSimpleReflection n) (MvPolynomial.C scalar) =
      MvPolynomial.C scalar := (polynomialAction n (firstSimpleReflection n)).commutes scalar
  rw [hconstant]
  simp only [map_mul, map_pow, map_neg, map_one]
  ring

/-- Every dihedral invariant is generated by the degree-two and signed degree-n invariants. -/
theorem _root_.Schubert.Dihedral.Invariants.le_generator_adjoin (n : ℕ) [NeZero n] (hthree : 3 ≤ n)
  :
    invariantSubalgebra n ≤
      Algebra.adjoin ℂ ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial) := by
  classical
  intro polynomial hinvariant
  let coordinates := auxiliaryCoordinateEquiv.symm polynomial
  let subalgebra :=
    Algebra.adjoin ℂ ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial)
  have hexpand : polynomial = ∑ exponent ∈ coordinates.support,
      MvPolynomial.C (coordinates.coeff exponent) *
        auxiliaryU ^ exponent 0 * auxiliaryV ^ exponent 1 := by
    calc
      polynomial = auxiliaryCoordinateEquiv coordinates :=
        (auxiliaryCoordinateEquiv.apply_symm_apply polynomial).symm
      _ = _ := by
        conv_lhs => rw [coordinates.as_sum, map_sum]
        apply Finset.sum_congr rfl
        intro exponent _
        exact auxiliaryCoordinateEquiv_monomial _ _
  have hsymmetrized : polynomial + polynomialAction n (firstSimpleReflection n) polynomial ∈
      subalgebra := by
    rw [hexpand, map_sum, ← Finset.sum_add_distrib]
    apply subalgebra.sum_mem
    intro exponent hsupport
    rw [auxiliary_monomial_reflection_sum]
    apply subalgebra.mul_mem (subalgebra.algebraMap_mem _)
    have hnonzero : coordinates.coeff exponent ≠ 0 :=
      MvPolynomial.mem_support_iff.mp hsupport
    rcases Nat.le_total (exponent 1) (exponent 0) with horder | horder
    · exact auxiliary_reflection_pair_mem_of_le n _ _ horder
        (_root_.Schubert.Dihedral.Invariants.coefficient_dvd_sub_reverse n hthree polynomial
          hinvariant
          exponent hnonzero horder)
    · exact auxiliary_reflection_pair_mem_of_ge n _ _ horder
        (invariant_auxiliary_coefficient_dvd_sub n hthree polynomial hinvariant
          exponent hnonzero horder)
  have hhalf : (MvPolynomial.C ((2 : ℂ)⁻¹) : CoordinatePolynomial) * 2 = 1 := by
    change MvPolynomial.C ((2 : ℂ)⁻¹) * MvPolynomial.C (2 : ℂ) = _
    rw [← map_mul]
    norm_num
  have hequal : MvPolynomial.C ((2 : ℂ)⁻¹) *
      (polynomial + polynomialAction n (firstSimpleReflection n) polynomial) = polynomial := by
    rw [(mem_invariantSubalgebra n polynomial).mp hinvariant]
    linear_combination polynomial * hhalf
  rw [← hequal]
  exact subalgebra.mul_mem (subalgebra.algebraMap_mem _) hsymmetrized

/-- The invariant subalgebra is generated by uv and the signed degree-n power sum. -/
theorem _root_.Schubert.Dihedral.Invariants.eq_generator_adjoin (n : ℕ) [NeZero n] (hthree : 3 ≤ n)
  :
    invariantSubalgebra n =
      Algebra.adjoin ℂ ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial) :=
  le_antisymm (_root_.Schubert.Dihedral.Invariants.le_generator_adjoin n hthree)
    (basicInvariant_adjoin_le n)

end Schubert.Dihedral
