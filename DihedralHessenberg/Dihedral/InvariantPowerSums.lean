import DihedralHessenberg.Dihedral.Invariants

/-! # Symmetric power sums in the basic invariant subalgebra

A two-variable power sum obeys the elementary recurrence determined by the sum and product
of its inputs. This gives polynomial expressions for the invariant auxiliary orbit pairs.
-/

noncomputable section

namespace Schubert.Dihedral

/-- Two-input power sums satisfy the sum-product recurrence. -/
theorem powerSum_recurrence (first second : CoordinatePolynomial) (degree : ℕ) :
    first ^ (degree + 2) + second ^ (degree + 2) =
      (first + second) * (first ^ (degree + 1) + second ^ (degree + 1)) -
        first * second * (first ^ degree + second ^ degree) := by
  simp only [pow_add, pow_one, pow_two]
  ring

/-- A subalgebra containing a sum and product contains every power sum of the two inputs. -/
theorem powerSum_mem_subalgebra (subalgebra : Subalgebra ℂ CoordinatePolynomial)
    (first second : CoordinatePolynomial) (hsum : first + second ∈ subalgebra)
    (hproduct : first * second ∈ subalgebra) (degree : ℕ) :
    first ^ degree + second ^ degree ∈ subalgebra := by
  induction degree using Nat.twoStepInduction with
  | zero =>
    simp only [pow_zero]
    exact subalgebra.add_mem subalgebra.one_mem subalgebra.one_mem
  | one => simpa using hsum
  | more degree hdegree hnext =>
    rw [powerSum_recurrence]
    exact subalgebra.sub_mem (subalgebra.mul_mem hsum hnext)
      (subalgebra.mul_mem hproduct hdegree)

/-- The subalgebra generated by the two basic invariant candidates consists of invariants. -/
theorem basicInvariant_adjoin_le (n : ℕ) [NeZero n] :
    Algebra.adjoin ℂ ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial) ≤
      invariantSubalgebra n := by
  apply Algebra.adjoin_le
  intro polynomial hpolynomial
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hpolynomial
  rcases hpolynomial with rfl | rfl
  · exact _root_.Schubert.Dihedral.Invariants.F2.mem n
  · exact higherInvariant_mem_invariantSubalgebra n

/-- Every fundamental auxiliary power pair is generated by the two basic invariants. -/
theorem _root_.Schubert.Dihedral.Invariants.power_pair_mem_adjoin (n degree : ℕ) :
    auxiliaryU ^ (n * degree) + MvPolynomial.C ((-1 : ℂ) ^ (n * degree)) *
        auxiliaryV ^ (n * degree) ∈
      Algebra.adjoin ℂ ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial) := by
  let subalgebra :=
    Algebra.adjoin ℂ ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial)
  have hquadratic : quadraticInvariant ∈ subalgebra := Algebra.subset_adjoin (by simp)
  have hhigher : higherInvariant n ∈ subalgebra := Algebra.subset_adjoin (by simp)
  have hproduct : auxiliaryU ^ n * (MvPolynomial.C ((-1 : ℂ) ^ n) * auxiliaryV ^ n) ∈
      subalgebra := by
    have heq : auxiliaryU ^ n * (MvPolynomial.C ((-1 : ℂ) ^ n) * auxiliaryV ^ n) =
        MvPolynomial.C ((-1 : ℂ) ^ n) * quadraticInvariant ^ n := by
      rw [quadraticInvariant, mul_pow]
      ring
    rw [heq]
    exact subalgebra.mul_mem (subalgebra.algebraMap_mem _) (subalgebra.pow_mem hquadratic n)
  have hsum : auxiliaryU ^ n + MvPolynomial.C ((-1 : ℂ) ^ n) * auxiliaryV ^ n ∈
      subalgebra := hhigher
  have hresult := powerSum_mem_subalgebra subalgebra (auxiliaryU ^ n)
    (MvPolynomial.C ((-1 : ℂ) ^ n) * auxiliaryV ^ n) hsum hproduct degree
  simpa only [mul_pow, ← map_pow, ← pow_mul] using hresult

/-- Multiplying an auxiliary orbit pair by any power of uv remains in the basic subalgebra. -/
theorem _root_.Schubert.Dihedral.Invariants.mixed_pair_mem_adjoin (n degree mixed : ℕ) :
    auxiliaryU ^ (n * degree + mixed) * auxiliaryV ^ mixed +
        MvPolynomial.C ((-1 : ℂ) ^ (n * degree)) *
          auxiliaryU ^ mixed * auxiliaryV ^ (n * degree + mixed) ∈
      Algebra.adjoin ℂ ({quadraticInvariant, higherInvariant n} : Set CoordinatePolynomial) := by
  have heq : auxiliaryU ^ (n * degree + mixed) * auxiliaryV ^ mixed +
        MvPolynomial.C ((-1 : ℂ) ^ (n * degree)) *
          auxiliaryU ^ mixed * auxiliaryV ^ (n * degree + mixed) =
      quadraticInvariant ^ mixed * (auxiliaryU ^ (n * degree) +
        MvPolynomial.C ((-1 : ℂ) ^ (n * degree)) * auxiliaryV ^ (n * degree)) := by
    simp only [quadraticInvariant, pow_add, mul_pow]
    ring
  rw [heq]
  exact (Algebra.adjoin ℂ _).mul_mem
    ((Algebra.adjoin ℂ _).pow_mem (Algebra.subset_adjoin (by simp)) mixed)
    (_root_.Schubert.Dihedral.Invariants.power_pair_mem_adjoin n degree)

end Schubert.Dihedral
