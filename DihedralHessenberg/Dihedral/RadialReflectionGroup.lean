import DihedralHessenberg.Dihedral.RealLinearAction
import DihedralHessenberg.Dihedral.Crystallographic

/-! # The linear reflection groups of radial root configurations -/

noncomputable section

namespace Schubert.Dihedral.RootLattice.Rescaling

variable {lattice : RootLattice} {n : ℕ} [NeZero n]

/-- The Euclidean normal reflection of a positive radial root. -/
def normal (data : Rescaling lattice n) (alpha : {vector // vector ∈ lattice.positive}) :
    RealPlane ≃ₗ[ℝ] RealPlane := realLinearAction n (data.equiv.symm alpha).reflection

/-- The packaged linear reflection has exactly the Euclidean normal formula. -/
theorem normal_apply (data : Rescaling lattice n) (alpha : {vector // vector ∈ lattice.positive})
    (vector : RealPlane) :
    data.normal alpha vector = vector - (2 * realBilinearForm vector alpha.val /
      realBilinearForm alpha.val alpha.val) • alpha.val := by
  let gamma := data.equiv.symm alpha
  have hvector : data.radius gamma • gamma.val = alpha.val :=
    congrArg Subtype.val (data.equiv.apply_symm_apply alpha)
  change realAction n gamma.reflection vector = _
  rw [← hvector]
  exact (data.reflection gamma vector).symm

/-- The linear group generated by the normal reflections of the radial positive roots. -/
def generated (data : Rescaling lattice n) : Subgroup (RealPlane ≃ₗ[ℝ] RealPlane) :=
  Subgroup.closure (Set.range data.normal)

/-- Every positive radial normal reflection belongs to its generated group. -/
theorem normal_mem (data : Rescaling lattice n) (alpha : {vector // vector ∈ lattice.positive}) :
    data.normal alpha ∈ data.generated := Subgroup.subset_closure ⟨alpha, rfl⟩

/-- Every signed root has its Euclidean normal reflection in the generated group. -/
theorem signed_normal (data : Rescaling lattice n) (normal : RealPlane)
    (hnormal : normal ∈ lattice.roots) :
    ∃ operator : data.generated, ∀ vector : RealPlane,
      operator.val vector = vector - (2 * realBilinearForm vector normal /
        realBilinearForm normal normal) • normal := by
  rcases hnormal with hnormal | hnormal
  · exact ⟨⟨data.normal ⟨normal, hnormal⟩, data.normal_mem _⟩, data.normal_apply _⟩
  · refine ⟨⟨data.normal ⟨-normal, hnormal⟩, data.normal_mem _⟩, ?_⟩
    intro vector
    rw [data.normal_apply]
    funext coordinate
    simp only [realBilinearForm, Pi.sub_apply, Pi.smul_apply, Pi.neg_apply, smul_eq_mul]
    ring

/-- The radial reflection-generated linear group is the faithful dihedral image. -/
theorem generated_range (data : Rescaling lattice n) (hthree : 3 ≤ n) :
    data.generated = (realLinearAction n).range := by
  have hnormals : Set.range data.normal =
      (realLinearAction n) '' Set.range (fun alpha : PositiveRoot n => alpha.reflection) := by
    ext operator
    constructor
    · rintro ⟨alpha, rfl⟩
      exact ⟨(data.equiv.symm alpha).reflection, ⟨data.equiv.symm alpha, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨alpha, rfl⟩, rfl⟩
      exact ⟨data.equiv alpha, by simp [normal]⟩
  have hgenerate : Subgroup.closure (Set.range (fun alpha : PositiveRoot n => alpha.reflection)) =
      ⊤ := by
    apply top_unique
    rw [← simple_roots_generate n hthree]
    apply Subgroup.closure_mono
    intro element hmem
    rcases hmem with rfl | rfl
    · exact ⟨simpleRoot n hthree 0, rfl⟩
    · exact ⟨simpleRoot n hthree 1, rfl⟩
  rw [generated, hnormals, ← MonoidHom.map_closure, hgenerate, Subgroup.map_top]

/-- The radial reflection group is isomorphic to the dihedral group. -/
def groupEquiv (data : Rescaling lattice n) (hthree : 3 ≤ n) :
    DihedralGroup n ≃* data.generated :=
  (MonoidHom.ofInjective (realLinearAction_injective n)).trans
    (MulEquiv.subgroupCongr (data.generated_range hthree).symm)

/-- The group identification is the action on every real vector. -/
theorem groupEquiv_apply (data : Rescaling lattice n) (hthree : 3 ≤ n)
    (element : DihedralGroup n) (vector : RealPlane) :
    (data.groupEquiv hthree element).val vector = realAction n element vector := rfl

end Schubert.Dihedral.RootLattice.Rescaling

namespace Schubert.Dihedral.RootLattice

/-- The A2 reflection-generated linear group is the three-sided dihedral group. -/
def a2GroupEquiv : DihedralGroup 3 ≃* a2Rescaling.generated :=
  a2Rescaling.groupEquiv (by decide)

/-- The B2 reflection-generated linear group is the four-sided dihedral group. -/
def b2GroupEquiv : DihedralGroup 4 ≃* b2Rescaling.generated :=
  b2Rescaling.groupEquiv (by decide)

/-- The C2 reflection-generated linear group is the four-sided dihedral group. -/
def c2GroupEquiv : DihedralGroup 4 ≃* c2Rescaling.generated :=
  c2Rescaling.groupEquiv (by decide)

/-- The G2 reflection-generated linear group is the six-sided dihedral group. -/
def g2GroupEquiv : DihedralGroup 6 ≃* g2Rescaling.generated :=
  g2Rescaling.groupEquiv (by decide)

end Schubert.Dihedral.RootLattice
