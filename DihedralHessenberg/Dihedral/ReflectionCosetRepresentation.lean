import DihedralHessenberg.Dihedral.ReflectionCosetBasic
import Mathlib.GroupTheory.GroupAction.Quotient
import Mathlib.RepresentationTheory.Basic
import Mathlib.Analysis.Complex.Basic

/-! # Standard reflection cosets and their permutation representation -/

namespace Schubert.Dihedral

/-- The subgroup generated by the reflection associated to a positive root. -/
def rootReflectionSubgroup {n : ℕ} (index : PositiveRootIndex n) : Subgroup (DihedralGroup n) :=
  Subgroup.closure {rootReflection index}

/-- The left cosets of the subgroup generated by a positive-root reflection. -/
abbrev RootReflectionCosets {n : ℕ} (index : PositiveRootIndex n) :=
  DihedralGroup n ⧸ rootReflectionSubgroup index

/-- The standard permutation representation on the left reflection cosets. -/
noncomputable def rootReflectionCosetRepresentation {n : ℕ} (index : PositiveRootIndex n) :
    Representation ℂ (DihedralGroup n) (MonoidAlgebra ℂ (RootReflectionCosets index)) :=
  Representation.ofMulAction ℂ (DihedralGroup n) (RootReflectionCosets index)

/-- A positive-root reflection subgroup has two elements. -/
theorem card_rootReflectionSubgroup {n : ℕ} (index : PositiveRootIndex n) :
    Nat.card (rootReflectionSubgroup index) = 2 := by
  rw [rootReflectionSubgroup, rootReflection_eq_sr]
  exact card_closure_sr n _

/-- There are n cosets of a positive-root reflection subgroup. -/
theorem card_rootReflectionCosets {n : ℕ} [NeZero n] (index : PositiveRootIndex n) :
    Nat.card (RootReflectionCosets index) = n := by
  change Nat.card (DihedralGroup n ⧸ Subgroup.closure {rootReflection index}) = n
  rw [rootReflection_eq_sr]
  exact card_quotient_closure_sr n _

end Schubert.Dihedral
