import DihedralHessenberg.Dihedral.RootReflectionAction
import DihedralHessenberg.Dihedral.RootPolynomial
import DihedralHessenberg.Paper.Hessenberg
import DihedralHessenberg.Splines.DotAction
import DihedralHessenberg.Splines.PolynomialCongruence

/-! # Splines on dihedral Hessenberg graphs

The geometric reflection representation supplies reflection-graph data: root reflections
are involutions, negate their own linear forms, and act trivially modulo those forms.
Selecting the roots in a Hessenberg ideal gives its labeled graph and spline algebra.
-/

noncomputable section

namespace Schubert.DihedralSplines

open Schubert.Dihedral Schubert.Splines

/-- The dihedral polynomial action has difference divisible by a reflected root's form. -/
theorem rootPolynomial_dvd_reflection_difference (n : ℕ) [NeZero n]
    (index : PositiveRootIndex n) (polynomial : CoordinatePolynomial) :
    rootPolynomial n index ∣ polynomial - polynomialAction n (rootReflection index) polynomial := by
  apply Ideal.mem_span_singleton.mp
  apply polynomial_hom_sub_mem (Ideal.span {rootPolynomial n index})
    (AlgHom.id ℂ CoordinatePolynomial) (polynomialAction n (rootReflection index)).toAlgHom
  intro coordinate
  rw [AlgHom.id_apply, polynomialAction_rootReflection, reflection_variable_difference]
  apply Ideal.mem_span_singleton.mpr
  exact dvd_mul_left _ _

/-- Reflection data furnished by the dihedral root representation. -/
def dihedralReflectionData (n : ℕ) (hthree : 3 ≤ n) :
    ReflectionGraphData ℂ CoordinatePolynomial (DihedralGroup n) (PositiveRootIndex n) := by
  letI : NeZero n := ⟨(lt_of_lt_of_le (by decide : 0 < 3) hthree).ne'⟩
  exact {
    action := polynomialAction n
    reflection := rootReflection
    label := rootPolynomial n
    reflection_square := rootReflection_mul_self
    reflection_label := fun index => by
      change (polynomialAction n (rootReflection index)).toAlgHom (rootPolynomial n index) = _
      rw [polynomialAction_rootReflection]
      exact reflection_normal_polynomial _ (complexPositiveRoot_nonisotropic n index)
    reflection_difference := rootPolynomial_dvd_reflection_difference n }

/-- A selected reflection edge has the ideal generated by its transformed geometric root. -/
theorem dihedralReflectionGraph_label (n : ℕ) (hthree : 3 ≤ n)
    (selected : Set (PositiveRootIndex n)) (edge : DihedralGroup n × selected) :
    ((dihedralReflectionData n hthree).reflectionGraph selected).label edge =
      Ideal.span {linearPolynomial (vectorOperator n edge.1 (complexPositiveRoot n edge.2))} := by
  change Ideal.span {polynomialOperator n edge.1 (rootPolynomial n edge.2)} = _
  rw [polynomialOperator, rootPolynomial, polynomialSubstitution_linearPolynomial]

/-- For any selected roots, the reflection graph has the geometric divisibility condition. -/
theorem dihedralReflectionGraph_isSpline_iff (n : ℕ) (hthree : 3 ≤ n)
    (selected : Set (PositiveRootIndex n)) (value : DihedralGroup n → CoordinatePolynomial) :
    ((dihedralReflectionData n hthree).reflectionGraph selected).IsSpline value ↔
      ∀ vertex index, index ∈ selected →
        linearPolynomial (vectorOperator n vertex (complexPositiveRoot n index)) ∣
          value vertex - value (vertex * rootReflection index) := by
  constructor
  · intro hvalue vertex index hindex
    have hedge := hvalue (vertex, ⟨index, hindex⟩)
    rw [dihedralReflectionGraph_label] at hedge
    exact Ideal.mem_span_singleton.mp hedge
  · intro hvalue edge
    rcases edge with ⟨vertex, index, hindex⟩
    rw [dihedralReflectionGraph_label]
    exact Ideal.mem_span_singleton.mpr (hvalue vertex index hindex)

/-- The right-reflection graph selected by a dihedral Hessenberg ideal. -/
def hessenbergGraph {n : ℕ} {hthree : 3 ≤ n} (ideal : HessenbergSpace n hthree) :
    IdealLabeledGraph CoordinatePolynomial (DihedralGroup n)
      (DihedralGroup n × {index : PositiveRootIndex n // index ∈ ideal.roots}) :=
  (dihedralReflectionData n hthree).reflectionGraph (ideal.roots : Set (PositiveRootIndex n))

/-- Polynomial-valued splines on the right-reflection graph of a Hessenberg ideal. -/
abbrev HessenbergSpline {n : ℕ} {hthree : 3 ≤ n} (ideal : HessenbergSpace n hthree) :=
  (hessenbergGraph ideal).Spline

/-- An edge label is the linear polynomial of the corresponding transformed geometric root. -/
theorem hessenbergGraph_label {n : ℕ} {hthree : 3 ≤ n} (ideal : HessenbergSpace n hthree)
    (vertex : DihedralGroup n) (index : PositiveRootIndex n) (hindex : index ∈ ideal.roots) :
    (hessenbergGraph ideal).label (vertex, ⟨index, hindex⟩) =
      Ideal.span {linearPolynomial (vectorOperator n vertex (complexPositiveRoot n index))} := by
  change Ideal.span {polynomialOperator n vertex (rootPolynomial n index)} = _
  rw [polynomialOperator, rootPolynomial, polynomialSubstitution_linearPolynomial]

/-- The Hessenberg graph spline condition is divisibility by every transformed root form. -/
theorem hessenbergGraph_isSpline_iff {n : ℕ} {hthree : 3 ≤ n}
    (ideal : HessenbergSpace n hthree) (value : DihedralGroup n → CoordinatePolynomial) :
    (hessenbergGraph ideal).IsSpline value ↔
      ∀ vertex index, index ∈ ideal.roots →
        linearPolynomial (vectorOperator n vertex (complexPositiveRoot n index)) ∣
          value vertex - value (vertex * rootReflection index) := by
  constructor
  · intro hvalue vertex index hindex
    have hedge := hvalue (vertex, ⟨index, hindex⟩)
    rw [hessenbergGraph_label] at hedge
    exact Ideal.mem_span_singleton.mp hedge
  · intro hvalue edge
    rcases edge with ⟨vertex, index, hindex⟩
    rw [hessenbergGraph_label]
    exact Ideal.mem_span_singleton.mpr (hvalue vertex index hindex)

/-- A Hessenberg spline satisfies the root-linear-form divisibility on every selected edge. -/
theorem hessenbergSpline_condition {n : ℕ} {hthree : 3 ≤ n}
    (ideal : HessenbergSpace n hthree) (value : HessenbergSpline ideal)
    (vertex : DihedralGroup n) (index : PositiveRootIndex n) (hindex : index ∈ ideal.roots) :
    polynomialOperator n vertex (rootPolynomial n index) ∣
      (value : DihedralGroup n → CoordinatePolynomial) vertex -
        (value : DihedralGroup n → CoordinatePolynomial) (vertex * rootReflection index) := by
  exact Ideal.mem_span_singleton.mp
    ((hessenbergGraph ideal).spline_condition value (vertex, ⟨index, hindex⟩))

end Schubert.DihedralSplines
