import DihedralHessenberg.Splines.ReflectionGraph
import DihedralHessenberg.Splines.IdealScalarExtension
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Left and right polynomial spline quotients

The variable ideal extends to reflection splines through their constant and orbit
polynomial maps. The two quotient algebras have the common base-ring scalar structure.
Their immediate API identifies generating coordinate splines, quotient maps, kernels,
and the defining zero relations. Grading and descended group actions are separate.
-/

noncomputable section

namespace Schubert.Splines.ReflectionGraphData

universe u v w z

variable {K : Type u} {P : Type v} {W : Type w} {T : Type z}
variable [CommRing K] [Group W]
variable (data : ReflectionGraphData K (MvPolynomial P K) W T)

/-- The variable ideal extended through the constant polynomial spline map. -/
def leftVariableIdeal (selected : Set T) : Ideal (data.Spline selected) :=
  Ideal.map (data.constantHom selected).toRingHom (MvPolynomial.idealOfVars P K)

/-- The variable ideal extended through the orbit polynomial spline map. -/
def rightVariableIdeal (selected : Set T) : Ideal (data.Spline selected) :=
  Ideal.map (data.orbitHom selected).toRingHom (MvPolynomial.idealOfVars P K)

/-- The left variable extension ideal is generated by the constant coordinate splines. -/
theorem leftVariableIdeal_eq_span (selected : Set T) :
    data.leftVariableIdeal selected =
      Ideal.span (Set.range fun coordinate =>
        data.constantSpline selected (MvPolynomial.X coordinate)) := by
  change Ideal.map (data.constantHom selected).toRingHom
    (Ideal.span (Set.range MvPolynomial.X)) = _
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- The right variable extension ideal is generated by the orbit coordinate splines. -/
theorem rightVariableIdeal_eq_span (selected : Set T) :
    data.rightVariableIdeal selected =
      Ideal.span (Set.range fun coordinate =>
        data.orbitSpline selected (MvPolynomial.X coordinate)) := by
  change Ideal.map (data.orbitHom selected).toRingHom
    (Ideal.span (Set.range MvPolynomial.X)) = _
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- The left extension ideal is the polynomial variable ideal times the whole left module. -/
theorem leftVariableIdeal_eq_smul_top (selected : Set T) :
    letI := data.leftAlgebra selected
    (data.leftVariableIdeal selected).restrictScalars (MvPolynomial P K) =
      MvPolynomial.idealOfVars P K •
        (⊤ : Submodule (MvPolynomial P K) (data.Spline selected)) := by
  let := data.leftAlgebra selected
  change (Ideal.map (algebraMap (MvPolynomial P K) (data.Spline selected))
    (MvPolynomial.idealOfVars P K)).restrictScalars (MvPolynomial P K) = _
  exact mapIdeal_restrictScalars_eq_smul_top (MvPolynomial.idealOfVars P K)

/-- The right extension ideal is the polynomial variable ideal times the whole right module. -/
theorem rightVariableIdeal_eq_smul_top (selected : Set T) :
    letI := data.rightAlgebra selected
    (data.rightVariableIdeal selected).restrictScalars (MvPolynomial P K) =
      MvPolynomial.idealOfVars P K •
        (⊤ : Submodule (MvPolynomial P K) (data.Spline selected)) := by
  let := data.rightAlgebra selected
  change (Ideal.map (algebraMap (MvPolynomial P K) (data.Spline selected))
    (MvPolynomial.idealOfVars P K)).restrictScalars (MvPolynomial P K) = _
  exact mapIdeal_restrictScalars_eq_smul_top (MvPolynomial.idealOfVars P K)

/-- The quotient by the left polynomial variable extension ideal. -/
abbrev LeftQuotient (selected : Set T) := data.Spline selected ⧸ data.leftVariableIdeal selected

/-- The quotient by the right polynomial variable extension ideal. -/
abbrev RightQuotient (selected : Set T) := data.Spline selected ⧸ data.rightVariableIdeal selected

/-- The canonical base-ring algebra map onto the left spline quotient. -/
def leftQuotientMap (selected : Set T) : data.Spline selected →ₐ[K] data.LeftQuotient selected :=
  Ideal.Quotient.mkₐ K (data.leftVariableIdeal selected)

/-- The canonical base-ring algebra map onto the right spline quotient. -/
def rightQuotientMap (selected : Set T) : data.Spline selected →ₐ[K] data.RightQuotient selected :=
  Ideal.Quotient.mkₐ K (data.rightVariableIdeal selected)

/-- The left quotient map is surjective. -/
theorem leftQuotientMap_surjective (selected : Set T) :
    Function.Surjective (data.leftQuotientMap selected) :=
  Ideal.Quotient.mkₐ_surjective K (data.leftVariableIdeal selected)

/-- The right quotient map is surjective. -/
theorem rightQuotientMap_surjective (selected : Set T) :
    Function.Surjective (data.rightQuotientMap selected) :=
  Ideal.Quotient.mkₐ_surjective K (data.rightVariableIdeal selected)

/-- The left quotient map has exactly the left variable extension ideal as its kernel. -/
theorem leftQuotientMap_ker (selected : Set T) :
    RingHom.ker (data.leftQuotientMap selected).toRingHom = data.leftVariableIdeal selected :=
  Ideal.Quotient.mkₐ_ker K (data.leftVariableIdeal selected)

/-- The right quotient map has exactly the right variable extension ideal as its kernel. -/
theorem rightQuotientMap_ker (selected : Set T) :
    RingHom.ker (data.rightQuotientMap selected).toRingHom = data.rightVariableIdeal selected :=
  Ideal.Quotient.mkₐ_ker K (data.rightVariableIdeal selected)

/-- A spline is zero in the left quotient exactly when it lies in the left variable ideal. -/
theorem leftQuotientMap_eq_zero_iff (selected : Set T) (value : data.Spline selected) :
    data.leftQuotientMap selected value = 0 ↔ value ∈ data.leftVariableIdeal selected :=
  Ideal.Quotient.eq_zero_iff_mem

/-- A spline is zero in the right quotient exactly when it lies in the right variable ideal. -/
theorem rightQuotientMap_eq_zero_iff (selected : Set T) (value : data.Spline selected) :
    data.rightQuotientMap selected value = 0 ↔ value ∈ data.rightVariableIdeal selected :=
  Ideal.Quotient.eq_zero_iff_mem

/-- Constant coordinate splines vanish in the left quotient. -/
theorem leftQuotientMap_coordinate (selected : Set T) (coordinate : P) :
    data.leftQuotientMap selected
      (data.constantSpline selected (MvPolynomial.X coordinate)) = 0 := by
  apply (data.leftQuotientMap_eq_zero_iff selected _).mpr
  rw [data.leftVariableIdeal_eq_span]
  exact Ideal.subset_span (Set.mem_range_self coordinate)

/-- Orbit coordinate splines vanish in the right quotient. -/
theorem rightQuotientMap_coordinate (selected : Set T) (coordinate : P) :
    data.rightQuotientMap selected (data.orbitSpline selected (MvPolynomial.X coordinate)) = 0 := by
  apply (data.rightQuotientMap_eq_zero_iff selected _).mpr
  rw [data.rightVariableIdeal_eq_span]
  exact Ideal.subset_span (Set.mem_range_self coordinate)

end Schubert.Splines.ReflectionGraphData
